APP_NAME=Vendove
# leave empty to build links from the current host
APP_URL=http://localhost/marketplace
APP_DEBUG=false
APP_TIMEZONE=America/New_York
# base64 of 32 random bytes, encrypts chat keys. generate with:
# php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
APP_KEY=your-base64-app-key-here

DB_HOST=localhost
DB_PORT=3306
DB_NAME=marketplace
DB_USER=your-db-user
DB_PASS=your-db-password

# test keys from dashboard.stripe.com/test/apikeys. checkout is disabled until both keys are set
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
# optional, from `stripe listen` or the dashboard webhook page
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_CURRENCY=usd

# leave MAIL_HOST empty to write outgoing mail to storage/logs/mail.log instead
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=Vendove

{
    "name": "vendove/marketplace",
    "description": "Peer-to-peer marketplace with offers, buy requests, encrypted chat and Stripe checkout",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "stripe/stripe-php": "^15.10",
        "phpmailer/phpmailer": "^6.9"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "scripts": {
        "lint": "php-cs-fixer fix --dry-run --diff",
        "format": "php-cs-fixer fix"
    }
}
